# --- Database ---
# For local development (SQLite):
DATABASE_URL=sqlite:///./kairaly.db

# For production (PostgreSQL), use something like:
# DATABASE_URL=postgresql://kairaly_user:kairaly_pass@localhost:5432/kairaly_db

# --- Security ---
# Generate a strong secret with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_long_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Default Admin (created by seed script) ---
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change_this_password
DEFAULT_ADMIN_EMAIL=admin@kairalyfurniture.com

# --- Uploads ---
UPLOAD_DIR=static/uploads
MAX_IMAGE_SIZE_MB=5

# --- CORS ---
# Comma separated list of allowed origins (use * for dev only)
CORS_ORIGINS=*
